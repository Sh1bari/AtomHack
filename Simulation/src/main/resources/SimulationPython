import numpy as np
import matplotlib.pyplot as plt
from matplotlib.patches import Rectangle

# ------------------ ПАРАМЕТРЫ СИСТЕМЫ ------------------
g = 9.81
rho = 1000
mu = 1.5e-3
dt = 0.5
n_steps = 3

# Считаем, что физически уровень может быть до 10 м:
MAX_LEVEL = 10.0

# Исходные данные
reservoirs = [
    {'S': 1.5, 'P0': 1.2 * rho * g, 'h0': 9.2},  # начальный уровень = 1.2 м
    {'S': 2.0, 'P0': 0.7 * rho * g, 'h0': 5.7},
    {'S': 1.8, 'P0': 1.6 * rho * g, 'h0': 2.6},
    {'S': 1.2, 'P0': 1.0 * rho * g, 'h0': 1.0},
    {'S': 1.0, 'P0': 1.8 * rho * g, 'h0': 1.8},
]

connections = [
    {'i': 0, 'j': 1, 'S': 0.15},
    {'i': 1, 'j': 2, 'S': 0.10},
    {'i': 2, 'j': 3, 'S': 0.08},
    {'i': 3, 'j': 4, 'S': 0.18},
    {'i': 0, 'j': 3, 'S': 0.22},
    {'i': 1, 'j': 4, 'S': 0.12}
]

# Координаты для отображения
reservoir_pos = np.array([
    [4,  0.0],
    [6, -3.0],
    [8,  0.0],
    [10, -3.0],
    [12, 0.0]
])

# ------------------ КЛАСС ВИЗУАЛИЗАЦИИ ------------------
class HydraulicVisualizer:
    def __init__(self):
        self.fig, self.ax = plt.subplots(figsize=(16, 8))
        self.ax.set_xlim(0, 14)
        self.ax.set_ylim(-4, 3)
        self.ax.axis('off')

        self.pipe_color = '#616a6b'
        self.tank_body_color = '#ecf0f1'
        self.tank_edge_color = '#34495e'
        self.water_color     = '#3498db'

    def draw_reservoirs(self, h):
        """
        Рисуем "резервуар" высотой 2 px, но уровень h[i] может быть до 10 м.
        => Масштабируем: water_level_display = (h[i]/MAX_LEVEL)*2.
        """
        h_full_display = 2.0  # визуальная высота
        for i, (x, y) in enumerate(reservoir_pos):
            w = 1.0
            # Корпус
            self.ax.add_patch(Rectangle(
                (x - w/2, y), w, h_full_display,
                facecolor=self.tank_body_color,
                edgecolor=self.tank_edge_color,
                linewidth=1.5, zorder=2
            ))
            # Переводим физический уровень (0..10) -> 0..2 для отображения
            scaled = (h[i]/MAX_LEVEL) * h_full_display
            # Не выходим за рамки [0..2]
            scaled_display = max(0, min(scaled, h_full_display))

            # Добавляем "воду" внутри
            self.ax.add_patch(Rectangle(
                (x - w/2, y), w, scaled_display,
                facecolor=self.water_color,
                edgecolor='none',
                alpha=0.7,
                zorder=3
            ))
            # Подпись
            self.ax.text(
                x, y + h_full_display + 0.15,
                f"Резервуар {i+1}",
                ha='center', va='bottom',
                fontsize=9, color='#2c3e50', weight='bold'
            )

    def draw_pipes(self, flows):
        for k, conn in enumerate(connections):
            i, j = conn['i'], conn['j']
            x1, y1 = reservoir_pos[i]
            x2, y2 = reservoir_pos[j]
            lw = conn['S'] * 10 + 0.5
            self.ax.plot(
                [x1, x2], [y1+1.0, y2+1.0],
                color=self.pipe_color,
                linewidth=lw,
                alpha=0.8,
                solid_capstyle='round',
                zorder=1
            )
            flow = flows[k]
            if abs(flow) > 1e-9:
                mx = (x1 + x2)/2
                my = (y1 + 1.0 + y2 + 1.0)/2
                sign = np.sign(flow)
                dx = (x2 - x1)*0.001*sign
                dy = (y2 - y1)*0.001*sign
                self.ax.annotate(
                    '',
                    xy=(mx + dx, my + dy),
                    xytext=(mx - dx, my - dy),
                    arrowprops=dict(
                        arrowstyle='->',
                        color='#2c3e50',
                        lw=2,
                        shrinkA=5,
                        shrinkB=5
                    ),
                    zorder=4
                )

    def add_info_panel(self, P, h):
        text = "Параметры системы\n\n"
        for i in range(len(P)):
            text += (
                f"[Резервуар {i+1}]\n"
                f"  Давление: {P[i]/1000:.1f} кПа\n"
                f"  Уровень:  {h[i]:.2f} м\n"
                f"  Объём:    {reservoirs[i]['S']*h[i]:.1f} м³\n\n"
            )
        self.ax.text(
            0.02, 0.96, text,
            transform=self.ax.transAxes,
            ha='left', va='top',
            fontsize=9,
            fontfamily='monospace',
            bbox=dict(
                facecolor='white',
                alpha=0.8,
                boxstyle='round,pad=0.5',
                edgecolor='#95a5a6'
            ),
            zorder=10
        )

    def set_title(self, t):
        self.ax.set_title(
            f"Гидравлическая система: состояние на шаге t={t:.1f} с",
            fontsize=12,
            pad=25,
            color='#2c3e50',
            weight='bold'
        )

# --------------- ЛОГИКА С РАСЧЁТОМ (УЧЁТ ВОДЫ) ----------------
def calculate_flows(P, h):
    """
    total[i] = P[i] + rho*g*h[i]
    dP = total[i] - total[j]
    flow = sign(dP)*S* sqrt(2*|dP|/rho)
    """
    flows = []
    for c in connections:
        i, j, S = c['i'], c['j'], c['S']
        total_i = P[i] + rho*g*h[i]
        total_j = P[j] + rho*g*h[j]
        dP = total_i - total_j
        if abs(dP) < 1e-9:
            flow = 0.0
        else:
            flow = np.sign(dP)*S*np.sqrt(2*abs(dP)/rho)
        flows.append(flow)
    return flows

# -------------- САМ "ШУРОВАТЕЛЬ" ------------------
n = len(reservoirs)
P = np.zeros(n)
h = np.zeros(n)

# Инициализируем газ.давление и уровень, без привязки "P= rho*g*h"
for i, r in enumerate(reservoirs):
    P[i] = r['P0']  # Па
    h[i] = r['h0']  # метры
    if h[i] > MAX_LEVEL:
        h[i] = MAX_LEVEL

history = []

for step in range(n_steps):
    flows = calculate_flows(P, h)
    history.append((P.copy(), h.copy(), flows.copy()))

    dP = np.zeros_like(P)
    for k, c in enumerate(connections):
        i, j, S = c['i'], c['j'], c['S']
        flow = flows[k]

        # Давление
        dP[i] -= flow*rho*g / reservoirs[i]['S']
        dP[j] += flow*rho*g / reservoirs[j]['S']

        # Перенос воды
        dV = flow*dt
        h[i] -= dV/reservoirs[i]['S']
        h[j] += dV/reservoirs[j]['S']

        # Ограничиваем уровень
        if h[i]<0: h[i]=0
        if h[j]>MAX_LEVEL: h[j] = MAX_LEVEL

    # Применяем dP, обнуляем негатив
    P += dP*dt
    P = np.clip(P, 0, None)

# ----- Визуализация -----
import matplotlib.pyplot as plt

for i, (P_iter, h_iter, flows_iter) in enumerate(history):
    vis = HydraulicVisualizer()
    vis.draw_reservoirs(h_iter)
    vis.draw_pipes(flows_iter)
    vis.add_info_panel(P_iter, h_iter)
    vis.set_title(i*dt)
    plt.tight_layout()
    plt.show()
